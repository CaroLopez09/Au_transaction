# Plantilla de los secretos locales. Copiar a `.env` y rellenar con valores reales.
#   cp .env.example .env
# `.env` esta en .gitignore: nunca debe subirse al repositorio.
# En cert y prod estas variables las inyecta el gestor de secretos del entorno.

# --- KiraFin: las entrega Kira por canal seguro ---
KIRA_API_KEY=
KIRA_CLIENT_ID=
KIRA_PASSWORD=
KIRA_WEBHOOK_SECRET=
# Solo mientras se rota el secreto en el dashboard de Kira; borrar al terminar.
KIRA_WEBHOOK_SECRET_PREVIOUS=

# --- Base de datos local ---
DB_PASSWORD=

# --- Firma de los JWT del BFF (minimo 32 bytes) ---
BFF_JWT_SECRET=
# Clave para cifrar los secretos TOTP. Obligatoria en cert y prod (32+ caracteres).
BFF_MFA_ENCRYPTION_KEY=

# Terminos que acepta la empresa (viaja a Kira como tos_accepted_version). Vacio: no se piden.
BFF_TERMS_VERSION=
BFF_TERMS_URL=
