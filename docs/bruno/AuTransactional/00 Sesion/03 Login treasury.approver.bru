meta {
  name: 03 Login treasury.approver
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "treasury.approver@{{empresa}}.test",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody().accessToken) {
    bru.setVar("tokenApprover", res.getBody().accessToken);
  }
}

tests {
  test("responde 200", function () {
    expect([200]).to.include(res.getStatus());
  });
}

docs {
  Guarda `tokenApprover`.
}
