meta {
  name: 04 Login admin de otra empresa
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@{{otraEmpresa}}.test",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody().accessToken) {
    bru.setVar("tokenOtraEmpresa", res.getBody().accessToken);
  }
}

tests {
  test("responde 200", function () {
    expect([200]).to.include(res.getStatus());
  });
}

docs {
  Sirve para comprobar el aislamiento entre organizaciones. Guarda `tokenOtraEmpresa`.
}
