meta {
  name: 01 Login admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@{{empresa}}.test",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody().accessToken) {
    bru.setVar("tokenAdmin", res.getBody().accessToken);
  }
}

tests {
  test("responde 200", function () {
    expect([200]).to.include(res.getStatus());
  });
}

docs {
  Guarda `tokenAdmin`.
}
