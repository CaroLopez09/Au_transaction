meta {
  name: 02 Login treasury.maker
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "treasury.maker@{{empresa}}.test",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody().accessToken) {
    bru.setVar("tokenMaker", res.getBody().accessToken);
  }
}

tests {
  test("responde 200", function () {
    expect([200]).to.include(res.getStatus());
  });
}

docs {
  Guarda `tokenMaker`.
}
