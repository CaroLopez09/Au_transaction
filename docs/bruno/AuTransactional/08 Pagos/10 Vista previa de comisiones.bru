meta {
  name: 10 Vista previa de comisiones
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/payouts/preview
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenMaker}}
}

body:json {
  {
    "virtualAccountId": "{{vaId}}",
    "recipientId": "{{recipientId}}",
    "amount": 1000.00
  }
}

docs {
  No reserva precio. `amount` = lo que recibe el destinatario (salvo recipientReceivesAmount=false).
}
