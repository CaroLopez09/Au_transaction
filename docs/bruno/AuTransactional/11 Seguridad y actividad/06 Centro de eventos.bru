get {
  url: {{baseUrl}}/api/events?limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("responde 200 sin payload", function () {
    expect(res.getStatus()).to.equal(200);
    (res.getBody() || []).forEach(e => expect(e).to.not.have.property("payload"));
  });
}
