meta {
  name: 03 Avisos
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/notifications?limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenCompliance}}
}

tests {
  test("responde 200 con items y contador", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("items");
    expect(res.getBody()).to.have.property("unread");
  });
}
