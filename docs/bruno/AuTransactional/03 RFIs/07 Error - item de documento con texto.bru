    "items": [
      { "itemId": "{{rfiDocItemId}}", "answerValue": "adjunto" },
      { "itemId": "i-inventado", "answerValue": "x" }
    ]
  }
}

docs {
  Con el RFI de prueba: 422 `rfi_answer_rejected` con `details` por item, sin llamar a Kira.
}
