meta {
  name: 06 Responder items de texto
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/rfis/{{rfiId}}/items
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "items": [
      { "itemId": "{{rfiTextItemId}}", "answerValue": "12-3456789" }
    ]
  }
}

docs {
  `answerValue` es texto, numero o booleano segun el `answer_type`. Llama a Kira: sin credenciales, 503.
}
