meta {
  name: 02 payout.status_changed (sobre V2)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/webhooks/kira
  body: text
  auth: none
}

body:text {
  {}
}

script:pre-request {
  const CryptoJS = require("crypto-js");
  const payload = { data: { event_id: "evt_" + Date.now(), event_type: "payout.status_changed", created_at: new Date().toISOString(), data: { payout_id: "pay_demo_001", status: "KYT_PENDING", previous_status: "PENDING" } } };
  const body = JSON.stringify(payload);
  req.setBody(body);
  req.setHeader("Content-Type", "application/json");
  req.setHeader("x-signature-sha256",
    CryptoJS.HmacSHA256(body, bru.getEnvVar("webhookSecret")).toString(CryptoJS.enc.Hex));
}

tests {
  test("responde 200", function () {
    expect([200]).to.include(res.getStatus());
  });
}

docs {
  El cuerpo real lo construye y firma el pre-request script.
}
