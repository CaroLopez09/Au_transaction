meta {
  name: 04 virtual_account.activated
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/webhooks/kira
  body: text
  auth: none
}

body:text {
  {}
}

script:pre-request {
  const CryptoJS = require("crypto-js");
  const payload = { event: "virtual_account.activated", data: { event_id: "evt_" + Date.now(), virtual_account_id: "kva_demo_001", status: "approved", account_number: "123456789", routing_number: "021000021", bank_name: "Slovak Savings Bank" } };
  const body = JSON.stringify(payload);
  req.setBody(body);
  req.setHeader("Content-Type", "application/json");
  req.setHeader("x-signature-sha256",
    CryptoJS.HmacSHA256(body, bru.getEnvVar("webhookSecret")).toString(CryptoJS.enc.Hex));
}

tests {
  test("responde 200", function () {
    expect([200]).to.include(res.getStatus());
  });
}

docs {
  El cuerpo real lo construye y firma el pre-request script.
