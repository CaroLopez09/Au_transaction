meta {
  name: 06 rfi.created
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/webhooks/kira
  body: text
  auth: none
}

body:text {
  {}
}

script:pre-request {
  const CryptoJS = require("crypto-js");
  const payload = { event: "rfi.created", data: { event_id: "evt_" + Date.now(), rfi_id: "rfi_demo_1", status: "pending" } };
  const body = JSON.stringify(payload);
  req.setBody(body);
  req.setHeader("Content-Type", "application/json");
  req.setHeader("x-signature-sha256",
    CryptoJS.HmacSHA256(body, bru.getEnvVar("webhookSecret")).toString(CryptoJS.enc.Hex));
}

tests {
  test("responde 200", function () {
    expect([200]).to.include(res.getStatus());
  });
}

docs {
