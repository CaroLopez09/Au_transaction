meta {
  name: 02 Alta UBO
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/ubos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenCompliance}}
}

body:json {
  {
    "firstName": "María",
    "lastName": "Pérez",
    "email": "maria.perez@juriscop.co",
    "documentType": "national_id",
    "documentNumber": "1020304050",
    "hasOwnership": true,
    "ownershipPercentage": 60.0,
    "hasControl": true,
    "isSigner": true,
    "politicallyExposed": false,
    "countryOfBirth": "COL",
    "roleInCompany": "Socia fundadora"
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody().id) {
    bru.setVar("uboId", res.getBody().id);
  }
}

tests {
  test("responde 200, o 422 si el correo ya esta registrado", function () {
    expect([200, 422]).to.include(res.getStatus());
  });
}

docs {
  Guarda `uboId`. La primera ejecucion crea a Maria; las siguientes responden 422 porque ya hay
  un beneficiario con ese correo (Kira empareja por email: dos filas con el mismo correo son la
  misma persona para Kira y duplicaban la participacion). En ese caso `uboId` sale de 01.

  `email` es opcional aqui, pero Kira empareja las personas de associated_persons[] por
  email: sin el, cada sincronizacion le crea una persona nueva, y no se le pueden subir
  documentos (422).
}
