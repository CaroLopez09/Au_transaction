meta {
  name: 01 Listar grupo
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/ubos
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenApprover}}
}

script:post-response {
  // Si ya hay beneficiarios, 03 Editar UBO trabaja sobre el primero aunque 02 no cree uno nuevo.
  const members = res.getBody().members || [];
  if (res.getStatus() === 200 && members.length && !bru.getVar("uboId")) {
    bru.setVar("uboId", members[0].id);
  }
}

tests {
  test("responde 200", function () {
    expect([200]).to.include(res.getStatus());
  });
}
