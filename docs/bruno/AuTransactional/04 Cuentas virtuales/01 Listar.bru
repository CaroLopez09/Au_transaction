meta {
  name: 01 Listar
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/virtual-accounts
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenApprover}}
}

script:post-response {
  const lista = res.getBody();
  if (Array.isArray(lista) && lista.length > 0 && !bru.getVar("vaId")) {
    bru.setVar("vaId", lista[0].id);
  }
}

tests {
  test("responde 200", function () {
    expect([200]).to.include(res.getStatus());
  });
}
