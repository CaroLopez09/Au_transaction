meta {
  name: 09 Error - veredicto repetido
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/identity/validate?verificationId={{verificationId}}&challengeId={{challengeId}}&livenessSessionId={{livenessSessionId}}&countryCode=CO&documentType=NATIONAL_ID
  body: multipartForm
  auth: none
}

params:query {
  verificationId: {{verificationId}}
  challengeId: {{challengeId}}
  livenessSessionId: {{livenessSessionId}}
  countryCode: CO
  documentType: NATIONAL_ID
}

body:multipart-form {
  selfieImage: @file(muestras/selfie.png)
  documentFrontImage: @file(muestras/documento-frente.png)
}

tests {
  test("responde 404", function () {
    expect([404]).to.include(res.getStatus());
  });
}
